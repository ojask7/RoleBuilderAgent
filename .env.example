# =============================================================================
# AccessForge — Environment Configuration
# Copy this file to .env and fill in real values before running.
# =============================================================================

# --- Postgres (used by docker-compose and Spring Boot) ---
POSTGRES_DB=agentdb
POSTGRES_USER=agent
POSTGRES_PASSWORD=agentpass
POSTGRES_PORT=5432

# --- Spring Boot API ---
AGENT_API_PORT=8080
AGENT_API_USERNAME=agent
AGENT_API_PASSWORD=agent-secret

# --- Azure OpenAI (REQUIRED for AI role mining) ---
# Get these from Azure Portal > your OpenAI resource > Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# =============================================================================
# INTEGRATION CONNECTORS (configure for your client environment)
# =============================================================================

# --- Azure AD / Entra ID (Microsoft Graph API) ---
# App Registration: Azure Portal > App Registrations > New
# Required Permissions: Directory.Read.All, Group.Read.All, User.Read.All
AZURE_AD_TENANT_ID=your-tenant.onmicrosoft.com
AZURE_AD_CLIENT_ID=your-app-registration-client-id
AZURE_AD_CLIENT_SECRET=your-app-registration-secret

# --- SailPoint IdentityNow ---
# Admin Console > API Management > Personal Access Tokens
SAILPOINT_TENANT=your-org
SAILPOINT_CLIENT_ID=your-sailpoint-client-id
SAILPOINT_CLIENT_SECRET=your-sailpoint-client-secret

# --- ServiceNow ---
# System Web Services > REST API > create integration user
SERVICENOW_INSTANCE=your-instance
SERVICENOW_USERNAME=accessforge-integration
SERVICENOW_PASSWORD=your-servicenow-password

# --- Optional: pgAdmin (web-based DB browser at http://localhost:5050) ---
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

# --- Frontend ---
FRONTEND_PORT=3000
