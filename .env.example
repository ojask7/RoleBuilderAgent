# =============================================================================
# RoleBuilderAgent — Environment Configuration
# Copy this file to .env and fill in real values before running.
# =============================================================================

# --- Postgres (used by docker-compose and Spring Boot) ---
POSTGRES_DB=agentdb
POSTGRES_USER=agent
POSTGRES_PASSWORD=agentpass
POSTGRES_PORT=5432

# --- Spring Boot API ---
AGENT_API_PORT=8080
AGENT_API_USERNAME=agent
AGENT_API_PASSWORD=agent-secret

# --- Azure OpenAI (REQUIRED for AI agents) ---
# Get these from Azure Portal > your OpenAI resource > Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# --- Optional: pgAdmin (web-based DB browser at http://localhost:5050) ---
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
